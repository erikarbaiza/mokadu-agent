# ── RESTOO (opcional, activa consulta de disponibilidad en tiempo real) ───────
# Token generado en: mokadu.myrestoo.net → Configuración → Usuarios → API Tokens
RESTOO_API_KEY=rst_XXXXXXXXX
RESTOO_PARTNER_ID=api
RESTOO_USER_ID=info@mokadubilbao.com
RESTOO_ACCOUNT_ID=mokadu

# ── OPCIÓN A: Twilio WhatsApp Sandbox (más fácil para empezar) ────────────────
# Cuenta gratis en: https://www.twilio.com
# Sandbox en: Console → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ── OPCIÓN B: Meta WhatsApp Cloud API (oficial, para producción) ──────────────
